{
  "name": "chuspanumeric",
  "version": "1.0.0",
  "description": "Numerical methods library for mathematics and engineering applications",
  "main": "dist/chuspanumeric.cjs",
  "module": "dist/chuspanumeric.esm.js",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src"
  ],
  "bin": {
    "chuspanumeric": "./src/cli/trazo-cli.js"
  },
  "exports": {
    ".": {
      "require": "./dist/chuspanumeric.cjs",
      "import": "./dist/chuspanumeric.esm.js"
    }
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "rollup -c",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --coverage",
    "lint": "eslint src tests scripts --max-warnings=0",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "check:circular": "madge --circular --extensions js src/",
    "prepare": "husky",
    "test:package": "node scripts/verificar-paquete.mjs"
  },
  "keywords": [
    "numerical-methods",
    "mathematics",
    "engineering"
  ],
  "homepage": "https://github.com/sis-inf/chuspanumeric#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sis-inf/chuspanumeric.git"
  },
  "bugs": {
    "url": "https://github.com/sis-inf/chuspanumeric/issues"
  },
  "author": "sis-inf",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "15.5.2",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "rollup": "^4.67.2",
    "@eslint/js": "9.39.4",
    "globals": "16.5.0"
  },
  "dependencies": {
    "mathjs": "^15.2.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
